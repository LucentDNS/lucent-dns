{
    "name": "Lucent DNS Filter",
    "description": "List for blocking ads in the Chinese region. Aims at privacy protection.",
    "homepage": "https://github.com/LucentDNS/lucent-dns",
    "sources": [
        {
            "name": "HaGeZi's Normal Blocklist",
            "source": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/multi.txt",
            "type": "adblock",
            "transformations": [
                "RemoveModifiers",
                "Validate"
            ]
        },
        {
            "name": "AdRules DNS List",
            "source": "https://raw.githubusercontent.com/Cats-Team/AdRules/main/dns.txt",
            "type": "adblock",
            "transformations": [
                "RemoveModifiers",
                "Validate"
            ]
        }
    ],
    "transformations": [
        "RemoveComments",
        "Deduplicate",
        "Compress"
    ]
}
