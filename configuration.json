{
    "name": "Lucent DNS Filter",
    "description": "DNS filtering rules compiled based on open-source data sources, covering advertisements, trackers, malware and phishing domains, specifically optimized for Chinese users",
    "homepage": "https://github.com/LucentDNS/lucent-dns",
    "sources": [
        {
            "name": "AdGuard DNS filter",
            "source": "https://adguardteam.github.io/AdGuardSDNSFilter/Filters/filter.txt",
            "type": "adblock",
            "transformations": [
                "ValidateAllowIp"
            ]
        },
        {
            "name": "ProtoConsent Core",
            "source": "https://cdn.jsdelivr.net/gh/ProtoConsent/data@main/lists/hosts/protoconsent_core.txt",
            "type": "hosts",
            "transformations": [
                "RemoveModifiers",
                "Validate",
                "Compress"
            ]
        }
    ],
    "transformations": [
        "RemoveComments",
        "Deduplicate",
        "Compress"
    ]
}
