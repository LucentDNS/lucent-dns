{
    "name": "Lucent DNS Filter",
    "description": "HaGeZi Normal + TIF Mini. A balanced, self-owned DNS filter for home and mobile use.",
    "homepage": "https://github.com/LucentDNS/lucent-dns",
    "version": "1.0.0",
    "sources": [
        {
            "name": "HaGeZi Normal",
            "source": "https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/normal.txt",
            "type": "adblock",
            "transformations": ["RemoveModifiers", "Validate"]
        },
        {
            "name": "HaGeZi TIF Mini",
            "source": "https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/tif.mini.txt",
            "type": "adblock",
            "transformations": ["RemoveModifiers", "Validate"]
        }
    ],
    "transformations": ["RemoveComments", "Deduplicate", "Compress"]
}
