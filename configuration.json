{
  "name": "Lucent DNS Filter",
  "description": "Compiled from AdGuard DNS filter and OISD Blocklist Big",
  "homepage": "https://github.com/LucentDNS/lucent-dns",
  "license": "MIT",
  "version": "1.0.0",

  "sources": [
    {
      "name": "AdGuard DNS filter",
      "source": "https://adguardteam.github.io/AdGuardSDNSFilter/Filters/filter.txt",
      "type": "adblock",
      "transformations": ["ValidateAllowIp"]
    },
    {
      "name": "OISD Blocklist Big",
      "source": "https://big.oisd.nl/",
      "type": "adblock",
      "transformations": ["RemoveModifiers", "Validate"]
    }
  ],

  "transformations": [
    "RemoveComments",
    "Deduplicate",
    "Compress",
    "RemoveEmptyLines",
    "InsertFinalNewLine"
  ],

  "exclusions_sources": ["./custom_exclusions.txt"]
}
