{
    "name": "Lucent DNS Filter",
    "description": "A list consisting of multiple filters, after simplification, to better comply with DNS-level ad-blocking requirements.",
    "homepage": "https://github.com/LucentDNS/lucent-dns",
    "sources": [
        {
            "name": "AdGuard DNS filter",
            "source": "https://adguardteam.github.io/AdGuardSDNSFilter/Filters/filter.txt",
            "type": "adblock",
            "transformations": [
                "ValidateAllowIp"
            ]
        },
        {
            "name": "pro-tif-mini",
            "source": "https://raw.githubusercontent.com/cbuijs/hagezi/main/combo/pro-tif-mini/domains.adblock",
            "type": "adblock",
            "transformations": [
                "RemoveModifiers",
                "Validate"
            ]
        }
    ],
    "transformations": [
        "RemoveComments",
        "Deduplicate",
        "Compress"
    ]
}
