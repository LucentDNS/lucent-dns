{
    "name": "Lucent DNS Filter",
    "description": "List of blocked advertisements and trackers.",
    "homepage": "https://github.com/LucentDNS/lucent-dns",
    "sources": [
        {
            "name": "HaGeZi's Normal Blocklist",
            "source": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/multi.txt",
            "type": "adblock",
            "transformations": [
                "RemoveModifiers",
                "Validate"
            ]
        },
        {
            "name": "OISD Blocklist Big",
            "source": "https://big.oisd.nl/",
            "type": "adblock",
            "transformations": [
                "RemoveModifiers",
                "Validate"
            ]
        }
    ],
    "transformations": [
        "RemoveComments",
        "Deduplicate",
        "Compress"
    ]
}
