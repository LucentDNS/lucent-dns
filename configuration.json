{
    "name": "Lucent DNS Filter",
    "description": "HaGeZi Multi PRO + TIF Mini + AdRules DNS List (Lite). A balanced, self-owned DNS filter for global and Chinese ads.",
    "homepage": "https://github.com/LucentDNS/lucent-dns",
    "license": "MIT",
    "sources": [
        {
            "name": "HaGeZi's Multi PRO",
            "source": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/pro.txt",
            "type": "adblock",
            "transformations": ["RemoveModifiers", "Validate"]
        },
        {
            "name": "HaGeZi's TIF Mini",
            "source": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/tif.mini.txt",
            "type": "adblock",
            "transformations": ["RemoveModifiers", "Validate"]
        },
        {
            "name": "AdRules DNS List (Lite)",
            "source": "https://raw.githubusercontent.com/Sereinfy/Adrules/main/rules/adblockdnslite.txt",
            "type": "adblock",
            "transformations": ["RemoveModifiers", "Validate"]
        }
    ],
    "transformations": ["RemoveComments", "Deduplicate", "Compress"],
    "exclusions_sources": [
        "https://raw.githubusercontent.com/AdguardTeam/AdGuardSDNSFilter/master/Filters/exclusions.txt"
    ]
}
