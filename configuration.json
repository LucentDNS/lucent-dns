{
    "name": "Lucent DNS Filter",
    "description": "AdGuard DNS filter (ads, trackers, Chinese regional, cryptominers) + HaGeZi native tracker lists (Windows/Office, Vivo) + HaGeZi TIF Mini (threat intelligence).",
    "homepage": "https://github.com/LucentDNS/lucent-dns",
    "sources": [
        {
            "name": "AdGuard DNS filter",
            "source": "https://adguardteam.github.io/AdGuardSDNSFilter/Filters/filter.txt",
            "type": "adblock",
            "transformations": [
                "ValidateAllowIp"
            ]
        },
        {
            "name": "HaGeZi's Windows/Office Tracker Blocklist",
            "source": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/native.winoffice.txt",
            "type": "adblock",
            "transformations": [
                "RemoveModifiers",
                "Validate"
            ]
        },
        {
            "name": "HaGeZi's Vivo Tracker Blocklist",
            "source": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/native.vivo.txt",
            "type": "adblock",
            "transformations": [
                "RemoveModifiers",
                "Validate"
            ]
        },
        {
            "name": "HaGeZi's Threat Intelligence Feeds - mini",
            "source": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/tif.mini.txt",
            "type": "adblock",
            "transformations": [
                "RemoveModifiers",
                "Validate"
            ]
        }
    ],
    "transformations": [
        "RemoveComments",
        "Deduplicate",
        "Compress"
    ]
}
