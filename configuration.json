{
    "name": "Lucent DNS Filter",
    "description": "A lightweight DNS filter merging HaGeZi's Pro Mini and TIF Mini, designed for both AdGuard Home and mobile AdGuard clients.",
    "homepage": "https://github.com/LucentDNS/lucent-dns",
    "license": "GPL-3.0",
    "version": "1.0.0",
    "sources": [
        {
            "name": "HaGeZi's Pro Mini Blocklist",
            "source": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/pro.mini.txt",
            "type": "adblock"
        },
        {
            "name": "HaGeZi's Threat Intelligence Feeds Mini",
            "source": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/tif.mini.txt",
            "type": "adblock"
        }
    ],
    "transformations": [
        "RemoveComments",
        "Deduplicate",
        "Compress"
    ]
}
